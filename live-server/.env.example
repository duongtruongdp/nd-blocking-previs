# The relay is intentionally private behind the reverse proxy.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# Exact browser origins that are allowed to open the WebSocket.
# Use origins, not paths and not the relay hostname.
LIVE_ALLOWED_ORIGINS=https://app.example.com,https://www.app.example.com

# Keep the public contract as wss://<relay-domain>/live.
LIVE_WEBSOCKET_PATH=/live

# In-memory room and abuse limits. Adjust only after observing production use.
LIVE_SESSION_TTL_MS=3600000
LIVE_HOST_RECONNECT_GRACE_MS=30000
LIVE_MAX_MESSAGE_BYTES=16777216
LIVE_MAX_VIEWERS_PER_SESSION=25
LIVE_MAX_SESSIONS=100
LIVE_MAX_MESSAGES_PER_SECOND=120
LIVE_MAX_TRANSFORMS_PER_SECOND=60
LIVE_MAX_INVALID_MESSAGES_PER_MINUTE=8
LIVE_MAX_CONNECTIONS_PER_IP=20
LIVE_MAX_SESSION_CREATES_PER_IP_PER_MINUTE=5
LIVE_HEARTBEAT_INTERVAL_MS=15000
LIVE_EDIT_LEASE_MS=8000
