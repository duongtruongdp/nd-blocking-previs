{
  "name": "nd-blocking-previs",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "build:web:staging": "vite build --mode staging",
    "desktop:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config src-tauri/tauri.conf.json",
    "live-server": "npm run live-server:build && node live-server/dist/live-server/server.js",
    "live-server:build": "tsc -p live-server/tsconfig.json",
    "release:package": "bash scripts/package-macos-release.sh",
    "release:verify": "node scripts/version-tools.mjs verify-release",
    "version:check": "node scripts/version-tools.mjs check",
    "version:set": "node scripts/version-tools.mjs set",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "relay:typecheck": "tsc -p relay/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@types/ws": "^8.18.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "mediabunny": "^1.61.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
