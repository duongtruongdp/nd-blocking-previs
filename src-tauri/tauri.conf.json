{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ND Blocking & Previs",
  "version": "0.1.1",
  "identifier": "net.duongtruongdp.blocking",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ND Blocking & Previs",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ndblock"
        ],
        "name": "ND Blocking Project",
        "description": "ND Blocking Project",
        "mimeType": "application/x-ndblock",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "net.duongtruongdp.blocking.project",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
